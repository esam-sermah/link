<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Merchant User / Agent Group -->
        <record id="group_link_user" model="res.groups">
            <field name="name">Merchant Agent</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Platform Administrator Group -->
        <record id="group_link_manager" model="res.groups">
            <field name="name">LINK Platform Administrator</field>
            <field name="implied_ids" eval="[(4, ref('group_link_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
