<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_link_service_request_list" model="ir.ui.view">
        <field name="name">link.service.request.list</field>
        <field name="model">link.service.request</field>
        <field name="arch" type="xml">
            <list string="Chat &amp; Service Requests" decoration-warning="state == 'pending_review'" decoration-success="state == 'confirmed'" decoration-info="state in ('collecting_info', 'collecting_docs')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="partner_phone"/>
                <field name="service_id"/>
                <field name="tenant_id"/>
                <field name="total_price"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="missing_requirements_summary"/>
                <field name="state" widget="badge" decoration-warning="state == 'pending_review'" decoration-success="state in ('confirmed', 'completed')" decoration-info="state in ('draft', 'collecting_info', 'collecting_docs')" decoration-danger="state in ('rejected', 'cancelled')"/>
                <field name="create_date" string="Request Date"/>
            </list>
        </field>
    </record>

    <record id="view_link_service_request_kanban" model="ir.ui.view">
        <field name="name">link.service.request.kanban</field>
        <field name="model">link.service.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="partner_phone"/>
                <field name="service_id"/>
                <field name="total_price"/>
                <field name="currency_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="fs-6"><field name="name"/></strong>
                            <field name="total_price" widget="monetary"/>
                        </div>
                        <div class="text-muted mb-1">
                            <span>Customer: </span><strong><field name="partner_id"/></strong>
                        </div>
                        <div class="text-muted mb-1">
                            <span>WhatsApp: </span><field name="partner_phone"/>
                        </div>
                        <div class="badge bg-secondary mb-2">
                            <field name="service_id"/>
                        </div>
                        <div t-if="record.state.raw_value == 'pending_review'" class="alert alert-warning py-1 px-2 m-0 text-center font-weight-bold" role="status">
                            Ready for Review &amp; Approval
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_link_service_request_form" model="ir.ui.view">
        <field name="name">link.service.request.form</field>
        <field name="model">link.service.request</field>
        <field name="arch" type="xml">
            <form string="Service Request Card">
                <header>
                    <button name="action_approve" string="Approve Request &amp; Notify" type="object" class="oe_highlight btn-success" invisible="state in ('confirmed', 'completed', 'rejected', 'cancelled')"/>
                    <button name="action_complete" string="Complete Request" type="object" class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_reject" string="Reject Request" type="object" class="btn-outline-danger" invisible="state in ('confirmed', 'completed', 'rejected', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,collecting_info,collecting_docs,pending_review,confirmed,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Request Number"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Customer &amp; Conversation Details">
                            <field name="partner_id"/>
                            <field name="partner_phone"/>
                            <field name="whatsapp_chat_id" readonly="1"/>
                            <field name="chatwoot_conversation_id"/>
                            <field name="tenant_id"/>
                        </group>
                        <group string="Service &amp; Financial Details">
                            <field name="service_id"/>
                            <field name="total_price"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="missing_requirements_summary" readonly="1"/>
                            <field name="reviewed_by" readonly="1" invisible="not reviewed_by"/>
                            <field name="confirmed_at" readonly="1" invisible="not confirmed_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mandatory Documents &amp; Attachments" name="documents">
                            <field name="document_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="attachment_id" widget="many2one_binary"/>
                                    <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-warning="state == 'received'" decoration-danger="state in ('missing', 'rejected')"/>
                                    <field name="rejection_reason"/>
                                    <button name="action_approve" string="Approve Document" type="object" icon="fa-check text-success" invisible="state == 'approved'"/>
                                    <button name="action_reject" string="Reject" type="object" icon="fa-times text-danger" invisible="state == 'rejected'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Collected Data (JSON)" name="data">
                            <field name="collected_data" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="AI &amp; System Audit Logs" name="audit_logs">
                            <field name="audit_log_ids" readonly="1">
                                <list>
                                    <field name="create_date" string="Timestamp"/>
                                    <field name="actor" widget="badge"/>
                                    <field name="action"/>
                                    <field name="payload"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_link_service_request" model="ir.actions.act_window">
        <field name="name">Chat Requests</field>
        <field name="res_model">link.service.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_pending_review': 1}</field>
    </record>
</odoo>
