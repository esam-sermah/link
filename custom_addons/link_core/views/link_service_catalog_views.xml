<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_link_service_catalog_list" model="ir.ui.view">
        <field name="name">link.service.catalog.list</field>
        <field name="model">link.service.catalog</field>
        <field name="arch" type="xml">
            <list string="Service Catalog">
                <field name="name"/>
                <field name="code"/>
                <field name="tenant_id"/>
                <field name="pricing_type"/>
                <field name="base_price"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="request_count"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-info="state == 'draft'" decoration-muted="state == 'archived'"/>
            </list>
        </field>
    </record>

    <record id="view_link_service_catalog_form" model="ir.ui.view">
        <field name="name">link.service.catalog.form</field>
        <field name="model">link.service.catalog</field>
        <field name="arch" type="xml">
            <form string="Service Details">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Service / Offer Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Bosnia All-inclusive Tour 7 Days"/>
                        </h1>
                        <label for="code" string="Service Code (Slug / SKU)"/>
                        <h3>
                            <field name="code" placeholder="bosnia-7days"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Business &amp; Category">
                            <field name="tenant_id"/>
                            <field name="category"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Official Deterministic Pricing">
                            <field name="pricing_type"/>
                            <field name="base_price"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Detailed Description &amp; Policies (AI Knowledge &amp; RAG)">
                        <field name="description" placeholder="Describe full itinerary, details, and policies for AI guidance..."/>
                    </group>
                    <notebook>
                        <page string="Required Attributes &amp; Fields" name="attributes">
                            <field name="attribute_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="field_key"/>
                                    <field name="field_type"/>
                                    <field name="selection_options"/>
                                    <field name="is_required"/>
                                    <field name="help_text"/>
                                </list>
                            </field>
                        </page>
                        <page string="Mandatory Documents &amp; Requirements" name="requirements">
                            <field name="requirement_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="requirement_code"/>
                                    <field name="requirement_type"/>
                                    <field name="is_mandatory"/>
                                    <field name="instruction_prompt"/>
                                </list>
                            </field>
                        </page>
                        <page string="Availability &amp; Schedule Rules" name="availability">
                            <field name="availability_rule_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="rule_type"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="max_capacity"/>
                                    <field name="note"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Price Calculation Rules &amp; Add-ons" name="pricing_rules">
                            <field name="price_rule_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="rule_type"/>
                                    <field name="amount"/>
                                    <field name="description"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_link_service_catalog" model="ir.actions.act_window">
        <field name="name">Services &amp; Offers</field>
        <field name="res_model">link.service.catalog</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
